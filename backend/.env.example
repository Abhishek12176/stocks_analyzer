# FastAPI configuration
APP_NAME=EquityLens API
DEBUG=false

# Server
PORT=8000

# CORS - comma-separated origins allowed to access the API
# For Render: set to your frontend domain
# Example: http://localhost:3000,https://equitylens.vercel.app
CORS_ORIGINS=http://localhost:3000

# API Key for authenticating frontend requests (optional)
# API_KEY=your-secret-api-key

# External API Keys
NEWSDATA_API_KEY=your-newsdata-api-key-here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cache TTLs (seconds)
CACHE_TTL_PRICE=60
CACHE_TTL_FUNDAMENTALS=3600
CACHE_TTL_SHAREHOLDING=86400
CACHE_TTL_NEWS=900
